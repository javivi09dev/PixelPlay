{
  "schemaVersion": 1,
  "id": "pixelplay",
  "version": "${version}",
  "name": "PixelPlay",
  "description": "Plays videos, fades and audio for players easily! Client-only; use PixelPlayFolia on the server.",
  "authors": [
    "Javivi"
  ],
  "contact": {
    "homepage": "https://javivi.dev"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/pixelplay/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.javivi.pp.client.PixelplayClient"
    ]
  },
  "accessWideners": [
    "pixelplay.accesswidener"
  ],
  "mixins": [
    "pixelplay.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "watermedia": ">=3.0.0-beta.11"
  }
}
